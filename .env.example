ENV=development
SERVER_PORT=8080
# One of: debug, info, warn, error. AddSource (file:line) is only enabled at debug.
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=taskflow
DB_PASSWORD=taskflow
DB_NAME=taskflow
DB_SSLMODE=disable
# Alternative to DB_PASSWORD: point this at a file (e.g. a mounted Docker/K8s
# secret) and its trimmed contents are used instead. Same convention as the
# official postgres/mysql Docker images.
# DB_PASSWORD_FILE=/run/secrets/db_password

JWT_SECRET=dev-secret-change-me
# In ENV=production this MUST be overridden to a random string >= 32 chars —
# the process refuses to start otherwise (see internal/config/config.go).
# Same DB_PASSWORD_FILE convention applies here too:
# JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_EXPIRES_IN=15m
# Refresh tokens are long-lived and rotated on every use (with reuse
# detection: presenting an already-used one revokes every session for that
# user). Must be longer than JWT_EXPIRES_IN.
REFRESH_TOKEN_EXPIRES_IN=720h

# Comma-separated list of origins allowed to call this API from a browser, or "*" for any.
CORS_ALLOWED_ORIGINS=*
# Per-client-IP token bucket: steady-state requests/sec and burst capacity.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
# Max time any single request may take before the server aborts it.
REQUEST_TIMEOUT=15s
# Max accepted request body size, in bytes (default 1MB).
MAX_BODY_BYTES=1048576
# How long the process waits after /readyz starts reporting "draining" but
# before actually shutting down — gives a load balancer time to notice.
SHUTDOWN_DRAIN_DELAY=5s

# Backs distributed (multi-replica-safe) rate limiting. Leave unset to fall
# back to in-memory, single-instance-only rate limiting.
# REDIS_ADDR=localhost:6379

# OTLP/HTTP endpoint to export distributed traces to (e.g. Jaeger, Tempo,
# an OTel Collector). Leave unset to disable trace export entirely.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
